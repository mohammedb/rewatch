{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rewatch",
  "version": "0.6.0",
  "identifier": "app.rewatch.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Rewatch",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "visible": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "bin/ffmpeg.exe": "bin/ffmpeg.exe",
      "bin/FFMPEG-LICENSE.txt": "bin/FFMPEG-LICENSE.txt",
      "bin/FFMPEG-NOTICE.txt": "bin/FFMPEG-NOTICE.txt"
    },
    "shortDescription": "Records your League of Legends games for review",
    "publisher": "Rewatch",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}